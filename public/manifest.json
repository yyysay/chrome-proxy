{
  "manifest_version": 3,
  "name": "Rule Proxy Lab",
  "description": "轻量 Chrome 规则分流扩展。",
  "version": "0.0.1",
  "permissions": [
    "storage",
    "proxy",
    "alarms"
  ],
  "host_permissions": [
    "https://ip125.com/*",
    "https://raw.githubusercontent.com/*",
    "https://ip125.com/*",
    "https://myip.ipip.net/*",
    "https://api-ipv4.ip.sb/*",
    "https://api.ip.sb/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Rule Proxy Lab",
    "default_popup": "popup.html"
  },
  "options_page": "onboarding.html"
}
